# Copy this file to `config.toml` and fill in your own values.
# `config.toml` is gitignored so your secrets are never committed.

# --- OAuth user flow (Authenticate(method="oauth")) ---
# OAuth 2.0 client credentials generated in the Google Cloud Console.
[credentials.oauth]
client_id = "YOUR_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_CLIENT_SECRET"

# --- Service account flow (Authenticate(method="service")) ---
[credentials.service]
# Path to the service account JSON key. Use an absolute path, or a path
# relative to the directory you run from.
key_file = "tests/your-service-account-key.json"

# Optional: only for Google Workspace domain-wide delegation. Email of the
# Workspace user to impersonate. Leave commented out to authenticate as the
# service account itself (in which case grant the service account email
# access to the property in Search Console).
# subject = "you@yourdomain.com"

# --- ADC impersonation flow (Authenticate(method="adc")) ---
# Keyless: no JSON key is read anywhere. The service account is named by email
# and Application Default Credentials sign the token request — an attached
# service account on GCE/Cloud Run, or a local
# `gcloud auth application-default login`.
#
# Requires the IAM Credentials API enabled, your ADC principal holding
# roles/iam.serviceAccountTokenCreator on this account, and THIS email added as
# a user on the property in Search Console (impersonating does not inherit the
# source identity's access). See docs/service-account-auth.md, Option C.
#
# Falls back to the GSC_SERVICE_ACCOUNT_EMAIL environment variable when unset.
[credentials.adc]
service_account_email = "presence@your-project.iam.gserviceaccount.com"

# --- Selenium login form (only used by the interactive OAuth flow) ---
[web_authentication]
email = "you@example.com"
password = "YOUR_PASSWORD"
